<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15 forces edge-to-edge, which ignores the status bar colour the app sets (so the bar stayed white,
         with white icons in dark mode) and stops the page resizing for the keyboard. Opt out so both work again. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
