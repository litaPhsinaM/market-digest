{
  "appId": "io.github.litaphsinam.marketdigest",
  "appName": "Stocksplain",
  "webDir": "www",
  "server": {
    "url": "https://stocksplain.app/",
    "androidScheme": "https",
    "errorPath": "offline.html",
    "allowNavigation": [
      "stocksplain.app",
      "www.stocksplain.app",
      "litaphsinam.github.io"
    ]
  },
  "android": {
    "backgroundColor": "#111110",
    "adjustMarginsForEdgeToEdge": "auto"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 900,
      "backgroundColor": "#111110",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": false,
      "backgroundColor": "#111110",
      "style": "DARK"
    }
  }
}
